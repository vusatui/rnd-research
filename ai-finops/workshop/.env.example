# Copy to .env (git-ignored). Free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional overrides (defaults in common/llm.py); run `python list_free_models.py` for current free models
LARGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
SMALL_MODEL=nvidia/nemotron-3.5-lightning:free
# Free tier: 20 requests/min per account; the client throttles to this
OPENROUTER_RPM=18
# Gateway exercise (ex4): master key for the local LiteLLM proxy
LITELLM_MASTER_KEY=sk-workshop-master-change-me
