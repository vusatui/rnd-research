# Copy to .env (git-ignored). Free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: pin a model (run `python list_free_models.py`); otherwise common/llm.py falls through a free-model list
OPENROUTER_MODEL=
# off (default) | low | medium | high | default - hidden reasoning makes free models slow and can truncate answers
OPENROUTER_REASONING=off
