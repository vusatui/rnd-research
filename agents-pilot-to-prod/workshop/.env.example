# Copy to .env (git-ignored). Free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: pin the agent model (run `python list_free_models.py`); otherwise common/llm.py falls through a list
OPENROUTER_MODEL=
# off (default) | low | medium | high | default - hidden reasoning makes free models slow and can truncate answers
OPENROUTER_REASONING=off
# Where to send traces (Phoenix in Docker: ./observability/up.sh). Unset = only out/traces.jsonl.
# Comment this out if Phoenix is not running (otherwise: noisy 'Connection refused' export retries).
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:6006/v1/traces
