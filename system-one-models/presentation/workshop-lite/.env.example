# --- Where does the client send its requests? (the same code works for all three) ---
# 1) Default: local emulator (free OpenRouter LLM pretending to be Jev). NOT real Jev.
JEV_BASE_URL=http://127.0.0.1:8787
JEV_API_KEY=anything
JEV_MODEL=jev-latest

# 2) Real Jev (needs a paid TypeSafe key from https://console.typesafe.ai/keys):
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_API_KEY=<your TypeSafe key>

# 3) Real Jev through OpenRouter (needs an OpenRouter key WITH credits; billed to your OpenRouter account):
# JEV_BASE_URL=https://openrouter.ai/api
# JEV_API_KEY=<your OpenRouter key>

# --- Only for the emulator (free key: https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
