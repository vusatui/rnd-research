# Copy to system-one-models/.env (never commit it). Used by every `make` target.
# Free key: https://openrouter.ai/keys  (without it, `make lite` switches to MOCK mode)
OPENROUTER_API_KEY=
# Free model for the emulator / deep-dive exercises. The free list changes: `make models`.
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Where the lite client sends requests. Empty = the emulator inside the container.
# Real Jev (paid key): JEV_BASE_URL=https://api.typesafe.ai  JEV_API_KEY=<TypeSafe key>
# JEV_BASE_URL=
# JEV_API_KEY=
JEV_MODEL=jev-latest

# Optional, deep-dive ex4 only (paid / waitlisted providers)
TYPESAFE_API_KEY=
OPENAI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
